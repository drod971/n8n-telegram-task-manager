# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-n8n-domain/webhook/telegram

# Google Sheets Configuration
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_SHEET_NAME=Tasks
GOOGLE_API_TYPE=service_account
GOOGLE_API_PROJECT_ID=your_project_id
GOOGLE_API_PRIVATE_KEY_ID=your_key_id
GOOGLE_API_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
GOOGLE_API_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_API_CLIENT_ID=your_client_id
GOOGLE_API_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_API_TOKEN_URI=https://oauth2.googleapis.com/token

# n8n Configuration
N8N_WEBHOOK_URL_BASE=https://your-n8n-domain
N8N_API_KEY=your_n8n_api_key_here

# Optional: Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Optional: Error tracking (Sentry)
SENTRY_DSN=https://key@sentry.io/project_id

# Feature Flags
ENABLE_RATE_LIMITING=true
RATE_LIMIT_DELAY_MS=2000
ENABLE_ERROR_LOGGING=true
ENABLE_TASK_NOTIFICATIONS=true
